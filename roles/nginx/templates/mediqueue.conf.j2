# Managed by Ansible - do not edit manually
# Load-balances across every host in the [app] inventory group
upstream mediqueue_app {
{% for host in groups['app'] %}
    server {{ hostvars[host]['ansible_host'] | default('127.0.0.1') }}:{{ app_port }};
{% endfor %}
}

server {
    listen {{ nginx_listen_port }} default_server;
    server_name {{ nginx_server_name }};

    access_log /var/log/nginx/mediqueue_access.log;
    error_log  /var/log/nginx/mediqueue_error.log;

    location / {
        proxy_pass http://mediqueue_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /health {
        access_log off;
        proxy_pass http://mediqueue_app/health;
    }
}
